# =============================================================================
# Toolcase Gateway - Runtime, Security & Database Configuration (.env)
# =============================================================================
# This file is strictly reserved for bootstrap concerns: runtime mode, database
# credentials, encryption key, and server binding. ALL application features,
# proxy settings, logging controls, models, fallbacks, accounts, and provider
# modules are configured dynamically in the Dashboard UI:
#   http://localhost:28130
#
# -----------------------------------------------------------------------------
# Runtime Mode
# -----------------------------------------------------------------------------
# Values: development | production (aliases: dev, prod, local, release).
# Precedence: --mode CLI flag > GATEWAY_ENV > GW_ENV > build profile
#   - debug build   -> development
#   - release build -> production
#
# Production mode fails closed when GW_ENCRYPTION_KEY is empty, unless
# GW_ALLOW_PLAINTEXT_CREDENTIALS=1 is set as an explicit opt-in.
# GATEWAY_ENV=production

# Optional bootstrap file overrides (defaults shown; relative to the cwd)
# GW_ENV_FILE=.env
# GW_CONFIG_FILE=gateway_config.json

# -----------------------------------------------------------------------------
# Database Security & Persistence
# -----------------------------------------------------------------------------
# Database connection URL (defaults to local embedded SQLite at $GW_STATE_DIR/gateway.db)
# Relative SQLite paths resolve under GW_STATE_DIR; sqlite://.gw_state/gateway.db
# is also accepted for backward compatibility.
# Supported connection types:
#   SQLite:     sqlite://gateway.db (or leave empty for the default local db)
#   PostgreSQL: postgres://username:secret_password@localhost:5432/toolcase_gateway
#   MySQL:      mysql://username:secret_password@localhost:3306/toolcase_gateway
DATABASE_URL=sqlite://gateway.db

# Directory for runtime state, thread caches, and the local SQLite database
GW_STATE_DIR=.gw_state

# Master key for AES-256-GCM credential envelope encryption at rest.
# Generate a secure 256-bit key using: openssl rand -hex 32
# If left empty, credentials in SQLite remain in plaintext (development only by
# default; production requires this key or an explicit plaintext opt-in).
GW_ENCRYPTION_KEY=

# Escape hatch for knowingly running production with plaintext credentials.
# Keep this at 0 unless you understand the risk.
GW_ALLOW_PLAINTEXT_CREDENTIALS=0

# -----------------------------------------------------------------------------
# Gateway Server Listener
# -----------------------------------------------------------------------------
# Network interface and port for the gateway process to bind
GW_LISTEN_HOST=127.0.0.1
GW_LISTEN_PORT=28130