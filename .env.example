# =============================================================================
# Toolcase Gateway - Environment Configuration Reference
# =============================================================================
# Copy this file to `.env` to customize local deployment settings.
# All operational and proxy routing settings:
#   - Upstream Proxy Target (Host & Port)
#   - Default Model & Fallback Chains
#   - Routing Modes & Capability Tiers
#   - Provider Accounts & API Keys (Jev, OpenRouter, Muse AI)
#   - Personal Modules & Extensions
# are configured dynamically through the Gateway Dashboard UI (`http://localhost:20129`)
# and safely persisted to the database.
#
# Only minimal server listener and persistence bootstrap settings belong in `.env`.

# -----------------------------------------------------------------------------
# Gateway Server Listener
# -----------------------------------------------------------------------------
# Network interface and port where the gateway listens
GW_LISTEN_HOST=127.0.0.1
GW_LISTEN_PORT=20129

# Maximum concurrent client TCP connections (admission controller)
GW_MAX_CONNECTIONS=256

# Socket I/O timeout in seconds for request headers, bodies, and proxying
GW_IO_TIMEOUT_SECS=120

# -----------------------------------------------------------------------------
# Database & Persistence (Clean Architecture Repository Port)
# -----------------------------------------------------------------------------
# Database connection URL (defaults to local SQLite at $GW_STATE_DIR/gateway.db)
# Examples:
#   SQLite:     sqlite://.gw_state/gateway.db (or leave empty for default)
#   PostgreSQL: postgres://user:password@localhost:5432/toolcase_gateway
#   MySQL:      mysql://user:password@localhost:3306/toolcase_gateway
# DATABASE_URL=

# Directory for runtime state, thread caches, and local sqlite database
GW_STATE_DIR=.gw_state

# -----------------------------------------------------------------------------
# Logging & Observability
# -----------------------------------------------------------------------------
# Master switch for gateway logging
GW_LOG_ENABLED=true

# Echo log messages to stdout / console
GW_LOG_CONSOLE=true

# Organize logs into date-based daily log files
GW_LOG_DAILY=true

# Directory where access, error, and system logs are stored
GW_LOG_DIR=logs

# Main log filename
GW_LOG_FILE=gateway.log

# Number of days to retain rotated log files before automatic cleanup
GW_LOG_RETENTION_DAYS=2

# Maximum size per log file in megabytes before rotation
GW_LOG_MAX_SIZE_MB=10

# Compress rotated logs into .zip format
GW_LOG_ZIP_ENABLED=true
