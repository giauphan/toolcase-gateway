# =============================================================================
# Toolcase Gateway - Runtime, Security & Database Configuration (.env)
# =============================================================================
# Bootstrap concerns only. Application features, proxy settings, logging,
# models, fallbacks, and provider modules live in the Dashboard UI:
#   http://localhost:28130
# Full reference: docs/CONFIGURATION.md

# -----------------------------------------------------------------------------
# Runtime Mode
# -----------------------------------------------------------------------------
# development | production (aliases: dev, prod, local, release).
# Precedence: --mode > GATEWAY_ENV > GW_ENV > build profile.
# SECURITY: production fails closed when GW_ENCRYPTION_KEY is empty; see
# "Production Bootstrap and Credential Policy" in docs/CONFIGURATION.md.
GATEWAY_ENV=production

# Optional bootstrap file overrides (defaults shown; relative to cwd)
# GW_ENV_FILE=.env
# GW_CONFIG_FILE=gateway_config.json

# -----------------------------------------------------------------------------
# Database Security & Persistence
# -----------------------------------------------------------------------------
# Connection URL; relative SQLite paths resolve under GW_STATE_DIR.
# SQLite:     sqlite://gateway.db (default when empty)
# PostgreSQL: postgres://username:secret_password@localhost:5432/toolcase_gateway
# MySQL:      mysql://username:secret_password@localhost:3306/toolcase_gateway
DATABASE_URL=sqlite://gateway.db

# Runtime state, thread caches, and the local SQLite database.
GW_STATE_DIR=.gw_state

# REQUIRED when GATEWAY_ENV=production: master key for AES-256-GCM credential
# envelope encryption at rest. Generate with: openssl rand -hex 32
# SECURITY: keep this value secret; never commit or paste it into docs.
# Credentials stored as plaintext by older builds are re-encrypted on startup
# whenever this key is set.
GW_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Gateway Server Listener
# -----------------------------------------------------------------------------
GW_LISTEN_HOST=127.0.0.1
GW_LISTEN_PORT=28130