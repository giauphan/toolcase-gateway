# =============================================================================
# Toolcase Gateway - Environment Configuration Reference
# =============================================================================
# Copy this file to `.env` to customize local deployment settings.
# All environment variables are optional; defaults are shown where applicable.

# -----------------------------------------------------------------------------
# Gateway Core & Network
# -----------------------------------------------------------------------------
# Gateway listener host and port
GW_LISTEN_HOST=127.0.0.1
GW_LISTEN_PORT=20129

# Upstream proxy target host and port (default OmniRoute / upstream backend)
GW_TARGET_HOST=127.0.0.1
GW_TARGET_PORT=20128

# Model routing defaults and fallback list (comma-separated model names)
GW_DEFAULT_MODEL=
GW_FALLBACK_MODELS=fail-try

# Maximum concurrent client TCP connections (admission controller)
GW_MAX_CONNECTIONS=256

# Socket I/O timeout in seconds for request headers, bodies, and proxying
GW_IO_TIMEOUT_SECS=120

# Exponential backoff parameters for retryable upstream requests (in milliseconds)
GW_RETRY_BASE_DELAY_MS=100
GW_MAX_RETRY_DELAY_MS=5000

# -----------------------------------------------------------------------------
# Storage & State Persistence
# -----------------------------------------------------------------------------
# Path to environment file reloaded by config store
GW_ENV_FILE=.env

# Path to persistent JSON configuration file (stores dynamic account pool, modules, etc.)
GW_CONFIG_FILE=gateway_config.json

# Directory for subsystem runtime state, thread caches, and temporary media artifacts
GW_STATE_DIR=.gw_state

# -----------------------------------------------------------------------------
# Routing Modes & Model Selection
# -----------------------------------------------------------------------------
# Routing mode: `existing` (default upstream), `round_robin`, `rules`, or `jev`
GW_ROUTING_MODE=existing

# Default model tier when selecting models by capability: `fast` or `strong`
GW_DEFAULT_TIER=strong

# -----------------------------------------------------------------------------
# Logging & Observability
# -----------------------------------------------------------------------------
# Master switch for gateway logging
GW_LOG_ENABLED=true

# Echo log messages to stdout / console
GW_LOG_CONSOLE=true

# Organize logs into date-based daily log files
GW_LOG_DAILY=true

# Directory where access, error, and system logs are stored
GW_LOG_DIR=logs

# Main log filename
GW_LOG_FILE=gateway.log

# Number of days to retain rotated log files before automatic cleanup
GW_LOG_RETENTION_DAYS=2

# Maximum size per log file in megabytes before rotation
GW_LOG_MAX_SIZE_MB=10

# Compress rotated logs into .zip format
GW_LOG_ZIP_ENABLED=true

# -----------------------------------------------------------------------------
# Muse AI Subsystem & Media Generation
# -----------------------------------------------------------------------------
# Muse AI API base URL and Noise WebSocket endpoint
GW_MUSEAI_BASE_URL=https://muse.ai
GW_MUSEAI_WS_URL=wss://hatch.metaaivm.com/v1/noise

# Authentication credentials (leave blank if not using Muse AI subsystem)
GW_MUSEAI_ACCESS_TOKEN=
GW_MUSEAI_NOTARY_TOKEN=
GW_MUSEAI_COOKIE=
GW_MUSEAI_VM_ID=

# Background thread maintenance and cleanup
GW_MUSEAI_AUTO_CLEANUP_THREADS=true
GW_MUSEAI_THREAD_RETENTION_SECS=172800

# Default video generation prompt for media preview routes
MUSE_LIVE_VIDEO_PROMPT="A colorful butterfly landing gently on a blooming sunflower, macro video"

# -----------------------------------------------------------------------------
# Muse Sentinel Approval Policy
# -----------------------------------------------------------------------------
# Approval mode: `off` (unrestricted), `on` (strict manual), `observe`, or `scoped_auto`
GW_MUSE_APPROVAL_MODE=off

# Comma-separated list of action types subject to approval (e.g. network, connector, terminal)
GW_MUSE_APPROVAL_ALLOWED_TYPES=network

# Comma-separated list of approved outbound domains / destinations
GW_MUSE_APPROVAL_ALLOWED_DESTINATIONS=

# Approval preferences and limits
GW_MUSE_APPROVAL_PREFER_ALLOW_ONCE=true
GW_MUSE_APPROVAL_ALLOW_ALWAYS=false
GW_MUSE_APPROVAL_MAX_DECISIONS=3
GW_MUSE_APPROVAL_TIMEOUT_SECS=30

# -----------------------------------------------------------------------------
# Jev Decision Engine & Account Pool
# -----------------------------------------------------------------------------
# Enable Jev decision gateway and routing
GW_JEV_ENABLED=false

# Shadow mode evaluates Jev in background without modifying production responses
GW_JEV_SHADOW_MODE=true

# Jev API upstream base URL
GW_JEV_BASE_URL=https://jev-ai.org

# Jev Native API keys: single key or multiple comma-separated keys (optionally label:key)
GW_JEV_API_KEYS=

# Cooldown duration in seconds when an account encounters rate limits / credit exhaustion
GW_JEV_CREDIT_COOLDOWN_SECS=300

# -----------------------------------------------------------------------------
# OpenRouter Provider & Account Pool
# -----------------------------------------------------------------------------
# Enable OpenRouter provider integration within Jev pool
GW_JEV_OPENROUTER_ENABLED=true

# OpenRouter API base URL
GW_JEV_OPENROUTER_BASE_URL=https://openrouter.ai

# Default OpenRouter credentials
GW_JEV_OPENROUTER_API_KEY=
GW_JEV_OPENROUTER_COOKIE=

# Default model and fallback model chain for OpenRouter
GW_JEV_OPENROUTER_MODEL=typesafe/jev-1.13
GW_JEV_OPENROUTER_FALLBACK_MODELS=

# Multi-account pool configuration (comma or newline delimited, supporting label:key syntax)
GW_JEV_OPENROUTER_API_KEYS=
GW_JEV_OPENROUTER_COOKIES=
