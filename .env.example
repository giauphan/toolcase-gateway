# =============================================================================
# Toolcase Gateway - Security & Database Configuration (.env)
# =============================================================================
# This file is strictly reserved for sensitive database credentials and server binding.
# ALL application features, proxy settings, logging controls, models, fallbacks,
# accounts, and provider modules are configured dynamically in the Dashboard UI:
#   http://localhost:28130
#
# -----------------------------------------------------------------------------
# Database Security & Persistence
# -----------------------------------------------------------------------------
# Database connection URL (defaults to local embedded SQLite at $GW_STATE_DIR/gateway.db)
# Supported connection types:
#   SQLite:     sqlite://.gw_state/gateway.db (or leave empty for default local db)
#   PostgreSQL: postgres://username:secret_password@localhost:5432/toolcase_gateway
#   MySQL:      mysql://username:secret_password@localhost:3306/toolcase_gateway
DATABASE_URL=sqlite://.gw_state/gateway.db

# Directory for runtime state, thread caches, and local sqlite database
GW_STATE_DIR=.gw_state

# Master key for AES-256-GCM credential envelope encryption at rest.
# Generate a secure 256-bit key using: openssl rand -hex 32
# If left empty, credentials in SQLite remain in plaintext.
GW_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Gateway Server Listener
# -----------------------------------------------------------------------------
# Network interface and port for the gateway process to bind
GW_LISTEN_HOST=127.0.0.1
GW_LISTEN_PORT=28130
