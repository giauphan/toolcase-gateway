# Gateway
GW_LISTEN_HOST=127.0.0.1
GW_LISTEN_PORT=20129
GW_TARGET_HOST=127.0.0.1
GW_TARGET_PORT=20128
GW_FALLBACK_MODELS=fail-try
GW_DEFAULT_MODEL=
GW_MAX_CONNECTIONS=256
GW_IO_TIMEOUT_SECS=120
GW_RETRY_BASE_DELAY_MS=100
GW_MAX_RETRY_DELAY_MS=5000
GW_ENV_FILE=.env

# Muse AI
GW_MUSEAI_BASE_URL=https://muse.ai
GW_MUSEAI_WS_URL=wss://hatch.metaaivm.com/v1/noise
GW_MUSEAI_COOKIE=
GW_MUSEAI_ACCESS_TOKEN=
GW_MUSEAI_NOTARY_TOKEN=
GW_MUSEAI_VM_ID=
GW_MUSEAI_AUTO_CLEANUP_THREADS=true
GW_MUSEAI_THREAD_RETENTION_SECS=86400

# Jev Decision API
# One or multiple comma-separated account keys.
GW_JEV_API_KEYS=
GW_JEV_BASE_URL=https://jev-ai.org
